  "panels": [
    {
      "id": 75,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Events from the plugin's own scripts and hooks. They appear only while the debug log is on: run `/paper-research:debug on` in your workspace, with `PAPER_RESEARCH_OTLP_ENDPOINT` set to `http://127.0.0.1:4318` in the `env` block of `~/.claude/settings.json` (Claude Code doesn't pass `OTEL_` variables to the plugin). They hold names, hosts, statuses, and timings, never notes or search text. Model calls, tokens, and cost come from Claude Code, not the plugin: see *paper-research: usage and security* and *paper-research: service details*."
      }
    },
    {
      "id": 76,
      "type": "stat",
      "title": "Commands",
      "description": "Script runs the plugin recorded.",
      "datasource": {
        "type": "loki",
