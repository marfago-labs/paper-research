      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (source, command, exit) (count_over_time({service_name=\"paper-research\"} | event_name=\"command\" [$__range]))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data. This needs the debug log on: run /paper-research:debug on, then use the plugin",
          "custom": {
            "minWidth": 70
