            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"api_request\" | unwrap ttft_ms [$__interval]) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data in this time range",
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
