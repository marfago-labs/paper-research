{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/init/scripts/init.py\" --hook rules || python \"${CLAUDE_PLUGIN_ROOT}/skills/init/scripts/init.py\" --hook rules",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/init/scripts/init.py\" --hook lessons || python \"${CLAUDE_PLUGIN_ROOT}/skills/init/scripts/init.py\" --hook lessons",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/init/scripts/init.py\" --hook guard || python \"${CLAUDE_PLUGIN_ROOT}/skills/init/scripts/init.py\" --hook guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/recap/scripts/recap.py\" --stop-hook || python \"${CLAUDE_PLUGIN_ROOT}/skills/recap/scripts/recap.py\" --stop-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
